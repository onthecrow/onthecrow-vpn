<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility for the per-app split-tunnel picker. Since Android 11 an app only sees
         packages it declares an interest in; querying for a LAUNCHER activity reveals every app the
         user can actually start, which is exactly the set worth routing by hand. Deliberately NOT
         QUERY_ALL_PACKAGES — that is a Play-restricted permission needing its own justification, and
         it would only add packages nobody picks from a list. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the VPN tunnel alive through Doze (request exemption at runtime). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Recovery holds a PARTIAL_WAKE_LOCK across the whole re-dial so the CPU cannot suspend
         half-way through re-establishing the tunnel. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Restore the tunnel after a reboot / app update if it was up when we lost it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".OnthecrowVpnApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing the Quick Settings tile opens this activity. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Hands the diagnostic log to the share sheet. Not exported: access is granted per-URI, per
             share, and revoked when the receiving app is done. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Quick Settings tile: tap toggles the tunnel with the selected config. Uses a dedicated
             full-bleed vector rather than the adaptive launcher foreground, whose safe-zone margin made
             the tile render smaller than every other app's. -->
        <service
            android:name=".VpnTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".vpn.BootRestoreReceiver"
            android:directBootAware="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Runs in the app process, deliberately. It owns the tun for the whole session, and the tun
             dies with its process — so the process that holds it must be the one thing that never
             needs restarting. Everything that DOES need restarting (libXray and its Go globals) lives
             in `:xray` below, where killing it costs nothing visible. -->
        <service
            android:name=".vpn.OnthecrowVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- libXray, and nothing else, in its own process so it can be killed and replaced without
             touching the tun. xray-core keeps package-level globals that stopping it does not clear
             (hysteria2's client-manager pool behind a sync.Once), so a genuinely fresh engine needs a
             genuinely fresh process — which used to mean killing the process that also held the tun,
             tearing the VPN down and blinking the system's VPN icon.

             Not exported and no android:permission: the only caller is our own app, and same-UID
             binds bypass permission checks anyway. Deliberately NOT a foreground service — it stays
             alive on the app process's BIND_IMPORTANT binding, and a second specialUse subtype would
             be a second hand-reviewed justification on Play for no capability we lack. -->
        <service
            android:name="com.onthecrow.onthecrowvpn.xray.ipc.XrayEngineService"
            android:exported="false"
            android:process=":xray" />
    </application>

</manifest>